{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot calibration state manifest",
  "type": "object",
  "required": [
    "states"
  ],
  "properties": {
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "state_id",
          "prompt",
          "images"
        ],
        "properties": {
          "state_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "prompt": {
            "type": "string",
            "description": "Saved ChatML input text with one current screenshot placeholder and <tools> schemas"
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "format": {
                  "enum": [
                    "png",
                    "jpg",
                    "jpeg"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
